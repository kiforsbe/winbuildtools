{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "installation",
    "application",
    "shortcuts",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "manufacturer",
        "upgradeCode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9.-]{0,49}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "manufacturer": {
          "type": "string",
          "minLength": 1
        },
        "upgradeCode": {
          "type": "string",
          "pattern": "^\\{[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}\\}$"
        }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "directoryName",
        "minimumWindowsBuild"
      ],
      "properties": {
        "scope": {
          "const": "machine"
        },
        "directoryName": {
          "type": "string",
          "minLength": 1
        },
        "minimumWindowsBuild": {
          "type": "integer",
          "minimum": 22000,
          "maximum": 999999
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable"
      ],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "appUserModelId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      }
    },
    "shortcuts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "location"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "const": "startMenu"
          }
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredFiles",
        "allowedExtensions",
        "allowedFiles"
      ],
      "properties": {
        "requiredFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowedExtensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\.[a-zA-Z0-9]+$"
          }
        },
        "allowedFiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowDirectoryChange": {
          "type": "boolean"
        },
        "licenseText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "layout": {
          "type": "string",
          "enum": [
            "brandedSidebar",
            "compactHeader"
          ]
        },
        "logo": {
          "minLength": 1,
          "maxLength": 240,
          "type": "string"
        },
        "sidebarImage": {
          "minLength": 1,
          "maxLength": 240,
          "type": "string"
        },
        "showBrowseButton": {
          "type": "boolean"
        },
        "completion": {
          "additionalProperties": false,
          "properties": {
            "launchApplication": {
              "type": "boolean"
            },
            "launchApplicationChecked": {
              "type": "boolean"
            },
            "showDetails": {
              "type": "boolean"
            },
            "helpUrl": {
              "minLength": 1,
              "maxLength": 1024,
              "type": "string"
            },
            "releaseNotesUrl": {
              "minLength": 1,
              "maxLength": 1024,
              "type": "string"
            },
            "messages": {
              "additionalProperties": false,
              "properties": {
                "repaired": {
                  "minLength": 1,
                  "maxLength": 160,
                  "type": "string"
                },
                "failed": {
                  "minLength": 1,
                  "maxLength": 160,
                  "type": "string"
                },
                "removed": {
                  "minLength": 1,
                  "maxLength": 160,
                  "type": "string"
                },
                "updated": {
                  "minLength": 1,
                  "maxLength": 160,
                  "type": "string"
                },
                "restartRequired": {
                  "minLength": 1,
                  "maxLength": 160,
                  "type": "string"
                },
                "canceled": {
                  "minLength": 1,
                  "maxLength": 160,
                  "type": "string"
                },
                "installed": {
                  "minLength": 1,
                  "maxLength": 160,
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        }
      }
    }
  }
}
