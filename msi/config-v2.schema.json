{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "installation",
    "application",
    "shortcuts",
    "payload",
    "architecture",
    "components"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "manufacturer",
        "upgradeCode",
        "productCode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9.-]{0,49}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "manufacturer": {
          "type": "string",
          "minLength": 1
        },
        "upgradeCode": {
          "type": "string",
          "pattern": "^\\{[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}\\}$"
        },
        "productCode": {
          "type": "string",
          "pattern": "^\\{[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}\\}$"
        }
      }
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "directoryName",
        "minimumWindowsBuild",
        "menuDirectoryName",
        "restartManager"
      ],
      "properties": {
        "scope": {
          "enum": [
            "user",
            "machine",
            "choice"
          ]
        },
        "directoryName": {
          "type": "string",
          "minLength": 1
        },
        "minimumWindowsBuild": {
          "type": "integer",
          "minimum": 22000,
          "maximum": 999999
        },
        "defaultScope": {
          "enum": [
            "user",
            "machine"
          ]
        },
        "menuDirectoryName": {
          "type": "string",
          "minLength": 1
        },
        "restartManager": {
          "enum": [
            "disabled",
            "graceful"
          ]
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executable"
      ],
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "type": "string",
          "minLength": 1
        },
        "appUserModelId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      }
    },
    "shortcuts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "location"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "const": "startMenu"
          }
        }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredFiles",
        "allowedExtensions",
        "allowedFiles"
      ],
      "properties": {
        "requiredFiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowedExtensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\.[a-zA-Z0-9]+$"
          }
        },
        "allowedFiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "architecture": {
      "enum": [
        "x64",
        "ARM64"
      ]
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 10000,
      "additionalProperties": {
        "type": "string",
        "pattern": "^\\{[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}\\}$"
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowDirectoryChange": {
          "type": "boolean"
        },
        "licenseText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  }
}
